<ui:FluentWindow x:Class="PauselyWindows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Pausely Overlay"
        WindowStyle="None"
        WindowBackdropType="Acrylic"
        Topmost="True"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        Loaded="Window_Loaded">
    
    <Grid>
        <!-- The Floating Card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
                CornerRadius="8" Padding="40" 
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="20" Opacity="0.5"/>
            </Border.Effect>
            
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Time to step away" Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                           FontFamily="Segoe UI Variable Display" FontSize="48" FontWeight="Light" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <Grid Margin="0,0,0,40" HorizontalAlignment="Center">
                    <!-- Layer 1: Ambient Glow / Dark Backing -->
                    <TextBlock Text="{Binding ElementName=TimerText, Path=Text}" Foreground="Black"
                               FontFamily="Segoe UI Variable Display" FontSize="120" FontWeight="Bold" 
                               HorizontalAlignment="Center" Opacity="0.3">
                        <TextBlock.Effect>
                            <BlurEffect Radius="24" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Layer 2: Main Glass Body -->
                    <TextBlock x:Name="TimerText" Text="20" 
                               FontFamily="Segoe UI Variable Display" FontSize="120" FontWeight="Bold" 
                               HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CCFFFFFF" Offset="0"/>
                                <GradientStop Color="#33FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <!-- Layer 3: Glass Bevel Edge -->
                    <TextBlock Text="{Binding ElementName=TimerText, Path=Text}" 
                               Foreground="#80FFFFFF"
                               FontFamily="Segoe UI Variable Display" FontSize="120" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="-2,-2,2,2" />
                               
                    <!-- Layer 4: Inner Shadow Fake -->
                    <TextBlock Text="{Binding ElementName=TimerText, Path=Text}" 
                               Foreground="#33000000"
                               FontFamily="Segoe UI Variable Display" FontSize="120" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="2,2,-2,-2" />
                </Grid>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button x:Name="SnoozeButton" Content="Snooze" Width="150" Height="40" 
                               Margin="0,0,20,0" Click="Snooze_Click" 
                               Appearance="Secondary" FontFamily="Segoe UI Variable Text" FontSize="16"/>
                    
                    <ui:Button x:Name="LockScreenButton" Content="Lock Screen" Width="150" Height="40" 
                               Click="LockScreen_Click" 
                               Appearance="Primary" FontFamily="Segoe UI Variable Text" FontSize="16"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
