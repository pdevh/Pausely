<Window x:Class="PauselyWindows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pausely Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="#D0000000"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid>
        <!-- Overlay for darkening the background -->
        <Rectangle Fill="#A0000000" />
        
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Time to step away" Foreground="White" FontSize="48" FontWeight="Light" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock x:Name="TimerText" Text="20" Foreground="White" FontSize="120" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Snooze (5m)" Width="150" Height="40" Margin="0,0,20,0" Click="Snooze_Click" Background="#444" Foreground="White" BorderThickness="0" FontSize="16"/>
                <Button Content="Skip" Width="150" Height="40" Click="Skip_Click" Background="#444" Foreground="White" BorderThickness="0" FontSize="16"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
