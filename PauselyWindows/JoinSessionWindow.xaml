<ui:FluentWindow x:Class="PauselyWindows.JoinSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Join Collaborative Session" WindowBackdropType="Mica"
        WindowCornerPreference="Round" WindowStartupLocation="CenterScreen"
        Width="460" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="32,24,32,32">
        <TextBlock Text="Join Collaborative Session" FontFamily="Segoe UI Variable Display"
                   FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock Text="Paste or enter a session code." FontSize="14" Margin="0,8,0,24"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Label Content="Session _code" Target="{Binding ElementName=CodeInput}" Padding="0" Margin="0,0,0,8" />
        <TextBox x:Name="CodeInput" FontFamily="Consolas" FontSize="24" Padding="12,8"
                 AutomationProperties.Name="Session code" TextChanged="CodeInput_TextChanged" />
        <TextBlock x:Name="Preview" Text="Enter a 6- or 11-character code. Legacy codes also work."
                   FontSize="12" Margin="0,8,0,24" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" Width="90" Margin="0,0,12,0" IsCancel="True" />
            <ui:Button x:Name="JoinButton" Content="Join" Width="90" Click="Join_Click"
                       Appearance="Primary" IsDefault="True" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
