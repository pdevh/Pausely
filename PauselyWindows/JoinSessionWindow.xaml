<ui:FluentWindow x:Class="PauselyWindows.JoinSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Join Collaborative Session"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Width="460" Height="260"
        ResizeMode="NoResize">

    <Grid Margin="0,32,0,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Join Collaborative Session" 
                       FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
            <TextBlock Text="Enter the 6-character session code" 
                       FontFamily="Segoe UI Variable Text" FontSize="14" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" HorizontalAlignment="Center"/>

            <Grid HorizontalAlignment="Center" MouseDown="Container_MouseDown">
                <TextBox x:Name="HiddenInput" Opacity="0.01" Background="Transparent" BorderThickness="0" 
                         Foreground="Transparent" SelectionBrush="Transparent" CaretBrush="Transparent"
                         Width="0" Height="0" MaxLength="6" TextChanged="HiddenInput_TextChanged" LostFocus="HiddenInput_LostFocus" GotFocus="HiddenInput_GotFocus"/>

                <UniformGrid Rows="1" Columns="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="Box0" Width="48" Height="60" Margin="6" CornerRadius="8" 
                            Background="{DynamicResource ControlFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="Text0" FontSize="32" FontWeight="Bold" FontFamily="Consolas" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <Border x:Name="Box1" Width="48" Height="60" Margin="6" CornerRadius="8" 
                            Background="{DynamicResource ControlFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="Text1" FontSize="32" FontWeight="Bold" FontFamily="Consolas" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <Border x:Name="Box2" Width="48" Height="60" Margin="6" CornerRadius="8" 
                            Background="{DynamicResource ControlFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="Text2" FontSize="32" FontWeight="Bold" FontFamily="Consolas" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <Border x:Name="Box3" Width="48" Height="60" Margin="6" CornerRadius="8" 
                            Background="{DynamicResource ControlFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="Text3" FontSize="32" FontWeight="Bold" FontFamily="Consolas" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <Border x:Name="Box4" Width="48" Height="60" Margin="6" CornerRadius="8" 
                            Background="{DynamicResource ControlFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="Text4" FontSize="32" FontWeight="Bold" FontFamily="Consolas" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <Border x:Name="Box5" Width="48" Height="60" Margin="6" CornerRadius="8" 
                            Background="{DynamicResource ControlFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="Text5" FontSize="32" FontWeight="Bold" FontFamily="Consolas" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                </UniformGrid>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <ui:Button Content="Cancel" Width="100" Height="36" Margin="0,0,16,0" 
                           Click="Cancel_Click" Appearance="Secondary" />
                <ui:Button x:Name="JoinButton" Content="Join" Width="100" Height="36" 
                           Click="Join_Click" Appearance="Primary" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
