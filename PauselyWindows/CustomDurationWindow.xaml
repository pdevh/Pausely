<ui:FluentWindow x:Class="PauselyWindows.CustomDurationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Custom Duration" WindowBackdropType="Mica" WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen" Width="460" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="32,24,32,32">
        <TextBlock x:Name="Heading" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="Explanation" FontSize="14" Margin="0,8,0,24" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="Preview" FontFamily="Consolas" FontSize="48" HorizontalAlignment="Center"
                   AutomationProperties.Name="Duration preview" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <TextBlock x:Name="PreviewLabel" FontSize="14" Margin="0,6,0,24" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Label Content="_Duration" Target="{Binding ElementName=DurationInput}" Padding="0" Margin="0,0,0,8" />
        <TextBox x:Name="DurationInput" FontFamily="Consolas" FontSize="18" Padding="12,8"
                 AutomationProperties.Name="Duration in seconds or clock notation"
                 TextChanged="DurationInput_TextChanged" />
        <TextBlock Text="Enter seconds (37), m:ss (2:37), or h:mm:ss." FontSize="12" Margin="0,8,0,20"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <UniformGrid x:Name="Adjustments" Rows="1" Columns="4">
            <ui:Button Content="−1 min" Tag="-60" Click="Adjust_Click" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                       AutomationProperties.Name="Subtract one minute" />
            <ui:Button Content="−1 sec" Tag="-1" Click="Adjust_Click" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                       AutomationProperties.Name="Subtract one second" />
            <ui:Button Content="+1 sec" Tag="1" Click="Adjust_Click" Margin="0,0,6,0" HorizontalAlignment="Stretch"
                       AutomationProperties.Name="Add one second" />
            <ui:Button Content="+1 min" Tag="60" Click="Adjust_Click" HorizontalAlignment="Stretch"
                       AutomationProperties.Name="Add one minute" />
        </UniformGrid>
        <TextBlock x:Name="Validation" FontSize="12" Margin="0,20,0,24" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" IsCancel="True" Width="90" Margin="0,0,12,0" />
            <ui:Button x:Name="SaveButton" Content="Save" Appearance="Primary" IsDefault="True" Width="90" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
