<ui:FluentWindow x:Class="PauselyWindows.CustomDurationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Custom Duration" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen" Width="400" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="28,44,28,28">
        <Label x:Name="Heading" Target="{Binding ElementName=DurationInput}"
               FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold"
               HorizontalAlignment="Center" Padding="0" Margin="0,0,0,20" />
        <TextBox x:Name="DurationInput" FontFamily="Consolas" FontSize="42" Padding="8,4" TextAlignment="Center"
                 AutomationProperties.HelpText="Enter seconds, minutes:seconds, or hours:minutes:seconds. From 1 second to 24 hours."
                 ToolTip="Enter seconds, m:ss, or h:mm:ss. From 1 second to 24 hours."
                 TextChanged="DurationInput_TextChanged" LostKeyboardFocus="DurationInput_LostKeyboardFocus" />
        <TextBlock x:Name="Validation" FontSize="12" Height="20" Margin="0,6,0,20" HorizontalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <UniformGrid x:Name="Adjustments" Rows="1" Columns="3" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Hours" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="−" x:Name="SubtractHour" Tag="-3600" Width="36" Padding="0" Click="Adjust_Click" Margin="0,0,4,0"
                               AutomationProperties.Name="Subtract one hour" />
                    <ui:Button Content="+" x:Name="AddHour" Tag="3600" Width="36" Padding="0" Click="Adjust_Click"
                               AutomationProperties.Name="Add one hour" />
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Minutes" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="−" x:Name="SubtractMinute" Tag="-60" Width="36" Padding="0" Click="Adjust_Click" Margin="0,0,4,0"
                               AutomationProperties.Name="Subtract one minute" />
                    <ui:Button Content="+" x:Name="AddMinute" Tag="60" Width="36" Padding="0" Click="Adjust_Click"
                               AutomationProperties.Name="Add one minute" />
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Seconds" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="−" x:Name="SubtractSecond" Tag="-1" Width="36" Padding="0" Click="Adjust_Click" Margin="0,0,4,0"
                               AutomationProperties.Name="Subtract one second" />
                    <ui:Button Content="+" x:Name="AddSecond" Tag="1" Width="36" Padding="0" Click="Adjust_Click"
                               AutomationProperties.Name="Add one second" />
                </StackPanel>
            </StackPanel>
        </UniformGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" IsCancel="True" Width="80" Margin="0,0,12,0" />
            <ui:Button x:Name="SaveButton" Content="Save" Appearance="Primary" IsDefault="True" Width="80" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
